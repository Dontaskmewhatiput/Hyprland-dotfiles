{
  "layer": "top",
  "output": [
    "DP-1"
  ],
  "position": "top",
  "passthrough": false,
  "margin-top": 6,
  "margin-right": 10,
  "margin-left": 10,
  "modules-left": [
    "tray",
    "clock"
  ],
  "modules-center": [
    "hyprland/workspaces"
  ],
  "modules-right": [
    "pulseaudio",
    "custom/orbit",
    "custom/power"
  ],
  "clock": {
    "format": "{:%H:%M}",
    "format-alt": "{:%Y %B %d, %A}",
    "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
    "on-click": "mode"
  },
  "pulseaudio": {
    "format": " {volume}%",
    "on-click": "pavucontrol",
  },
  "hyprland/workspaces": {
    "all-outputs": true,
    "on-click": "activate",
    "persistent-workspaces": {
      "*": [
        1,
        2,
        3,
        4,
        5
      ]
    }
  },
  "custom/orbit": {
    "exec": "orbit waybar-status",
    "format": "󰖩",
    "return-type": "json",
    "interval": 10,
    "on-click": "orbit toggle top-right"
  },
  "custom/power": {
    "format": "󰐥",
    "tooltip": false,
    "on-click": "wlogout -b 2"
  }
}
