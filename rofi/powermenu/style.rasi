configuration {
    show-icons: false;
}

* {
    background-color: transparent;
    text-color:       #ffffff;
    font:             "MonoLisa 11";
}

window {
    transparency:     "real";
    width:            180px;
    border:           1px;
    border-color:     rgba(255, 255, 255, 0.18);
    border-radius:    16px;
    background-color: rgba(20, 20, 25, 0.45);
    anchor:           north east;
    location:         north east;
    x-offset:         -12px;
    y-offset:         40px;
    children:         [ listview ];
}

listview {
    lines:            4;
    columns:          1;
    scrollbar:        false;
    padding:          6px;
    spacing:          4px;
    background-color: transparent;
}

element {
    padding:          8px 12px;
    border-radius:    10px;
    border:           1px;
    border-color:     rgba(255, 255, 255, 0.08);
    background-color: rgba(255, 255, 255, 0.05);
    text-color:       #ffffff;
    cursor:           pointer;
}

element selected {
    background-color: rgba(255, 255, 255, 0.22);
    border-color:     rgba(255, 255, 255, 0.35);
    text-color:       #ffffff;
}

element-text {
    background-color: transparent;
    text-color:       inherit;
}
