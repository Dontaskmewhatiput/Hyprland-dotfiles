@theme "/dev/null"

configuration {
    modi: "window,run,drun";
    display-drun: "Applications";
    display-window: "Windows";
    display-run: "Run";
    drun-display-format: "{icon} {name}";
    font: "Monolisa 10";
    show-icons: true;
    icon-theme: "Colloid";
}

* {
    /* Glassmorphic Material You Token Overrides */
    primary:                    #9df0f8;
    primary-fixed:              #9df0f8;
    primary-fixed-dim:          #80d4dc;
    on-primary:                 #002022;
    on-primary-fixed:           #002022;
    on-primary-fixed-variant:   #004f54;
    primary-container:          #004f54;
    on-primary-container:       #9df0f8;
    secondary:                  #b1cbce;
    secondary-fixed:            #cce8ea;
    secondary-fixed-dim:        #b1cbce;
    on-secondary:               #1b3437;
    on-secondary-fixed:         #051f21;
    on-secondary-fixed-variant: #324b4d;
    secondary-container:        #324b4d;
    on-secondary-container:     #cce8ea;
    tertiary:                   #b7c7ea;
    tertiary-fixed:             #d7e2ff;
    tertiary-fixed-dim:         #b7c7ea;
    on-tertiary:                #21304c;
    on-tertiary-fixed:          #0a1b36;
    on-tertiary-fixed-variant:  #384764;
    tertiary-container:         #384764;
    on-tertiary-container:      #d7e2ff;
    error:                      #ffb4ab;
    on-error:                   #690005;
    error-container:            #93000a;
    on-error-container:         #ffdad6;

    /* Glass Surfaces & Borders */
    surface:                    rgba(14, 20, 21, 0.45);
    surface-dim:                rgba(14, 20, 21, 0.35);
    surface-bright:             rgba(52, 58, 59, 0.45);
    surface-container-lowest:   rgba(9, 15, 16, 0.30);
    surface-container-low:      rgba(22, 29, 29, 0.40);
    surface-container:          rgba(26, 33, 33, 0.50);
    surface-container-high:     rgba(37, 43, 44, 0.60);
    surface-container-highest:  rgba(48, 54, 54, 0.70);

    on-surface:                 #dee4e4;
    on-surface-variant:         #bec8c9;
    outline:                    rgba(137, 147, 147, 0.30);
    outline-variant:            rgba(63, 72, 73, 0.20);
    shadow:                     transparent;
    scrim:                      transparent;
    inverse-surface:            #dee4e4;
    inverse-on-surface:         #2b3232;
    inverse-primary:            #006970;
}

window {
    transparency:                "real";
    location:                    center;
    anchor:                      center;
    fullscreen:                  false;
    width:                       1000px;
    x-offset:                    0px;
    y-offset:                    0px;

    enabled:                     true;
    border:                      1px solid;
    border-color:                var(outline);
    border-radius:               15px;
    cursor:                      "default";
    background-color:            var(surface);
}

mainbox {
    enabled:                     true;
    spacing:                     0px;
    background-color:            transparent;
    orientation:                 horizontal;
    children:                    [ "imagebox", "listbox" ];
}

imagebox {
    padding:                     20px;
    background-color:            transparent;
    background-image:            url("~/.config/hypr/current_wallpaper", height);
    orientation:                 vertical;
    children:                    [ "inputbar", "dummy", "mode-switcher" ];
}

listbox {
    spacing:                     20px;
    padding:                     20px;
    background-color:            transparent;
    orientation:                 vertical;
    children:                    [ "message", "listview" ];
}

dummy {
    background-color:            transparent;
}

inputbar {
    enabled:                     true;
    spacing:                     10px;
    padding:                     15px;
    border-radius:               10px;
    border:                      1px solid;
    border-color:                var(outline-variant);
    background-color:            var(surface-container-low);
    text-color:                  var(on-surface);
    children:                    [ "textbox-prompt-colon", "entry" ];
}

textbox-prompt-colon {
    enabled:                     true;
    expand:                      false;
    str:                         "  ";
    background-color:            inherit;
    text-color:                  inherit;
}

entry {
    enabled:                     true;
    background-color:            inherit;
    text-color:                  inherit;
    cursor:                      text;
    placeholder:                 "Search";
    placeholder-color:           var(on-surface-variant);
}

mode-switcher {
    enabled:                     true;
    spacing:                     20px;
    background-color:            transparent;
    text-color:                  var(on-surface);
}

button {
    padding:                     15px;
    border-radius:               10px;
    border:                      1px solid;
    border-color:                var(outline-variant);
    background-color:            var(surface-container-low);
    text-color:                  var(on-surface);
    cursor:                      pointer;
}

button selected {
    background-color:            var(primary);
    border-color:                var(primary-fixed);
    text-color:                  var(on-primary);
}

listview {
    enabled:                     true;
    columns:                     1;
    lines:                       8;
    cycle:                       true;
    dynamic:                     true;
    scrollbar:                   false;
    layout:                      vertical;
    reverse:                     false;
    fixed-height:                true;
    fixed-columns:               true;
    
    spacing:                     10px;
    background-color:            transparent;
    text-color:                  var(on-surface);
    cursor:                      "default";
}

element {
    enabled:                     true;
    spacing:                     15px;
    padding:                     8px;
    border-radius:               10px;
    border:                      1px solid;
    border-color:                transparent;
    background-color:            transparent;
    text-color:                  var(on-surface);
    cursor:                      pointer;
}

element normal.normal {
    background-color:            transparent;
    text-color:                  var(on-surface);
}

element normal.active {
    background-color:            var(surface-container-high);
    text-color:                  var(on-surface);
}

element selected.normal {
    background-color:            var(primary);
    border-color:                var(primary-fixed);
    text-color:                  var(on-primary);
}

element selected.active {
    background-color:            var(primary);
    border-color:                var(primary-fixed);
    text-color:                  var(on-primary);
}

element-icon {
    background-color:            transparent;
    text-color:                  inherit;
    size:                        32px;
    cursor:                      inherit;
}

element-text {
    background-color:            transparent;
    text-color:                  inherit;
    cursor:                      inherit;
    vertical-align:              0.5;
    horizontal-align:            0.0;
}

message {
    background-color:            transparent;
}

textbox {
    padding:                     15px;
    border-radius:               10px;
    border:                      1px solid;
    border-color:                var(outline-variant);
    background-color:            var(surface-container-low);
    text-color:                  var(on-surface);
    vertical-align:              0.5;
    horizontal-align:            0.0;
}
